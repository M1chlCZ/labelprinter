[Unit]
Description=Authenticated label print bridge (TLS PDF to CUPS)
After=network-online.target cups.service
Wants=network-online.target
Requires=cups.service

[Service]
Type=simple
User=labelprinter
Group=labelprinter
SupplementaryGroups=lpadmin
EnvironmentFile=-/etc/labelprinter/environment
ExecStart=/usr/bin/python3 /usr/local/lib/labelprinter/labelprinter.py
Restart=on-failure
StateDirectory=labelprinter
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
# Allow your LAN, for example:
# IPAddressAllow=192.168.0.0/16
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
